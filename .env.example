# Copy this file to .env and fill in your values.
# .env is gitignored — it will never be committed.

# ── Public URL (required when behind Cloudflare Tunnel or any reverse proxy) ──
# Used to build correct OAuth redirect URIs. No trailing slash.
DING_BASE_URL=https://ding.montra.me

# ── Network scanner ────────────────────────────────────────────
# Leave blank to auto-detect interface and subnet
DING_INTERFACE=
DING_SUBNET=
DING_PORTS=22,80,443,554,8000,8080,8443
DING_TIMEOUT_MS=500
DING_DATA_PATH=/data/ding.db
DING_HTTP_ADDR=:8081
DING_SCAN_INTERVAL=60s

# ── Telegram alerts (optional) ─────────────────────────────────
DING_TELEGRAM_TOKEN=
DING_TELEGRAM_CHAT_ID=

# ── Google OAuth (optional) ────────────────────────────────────
# Create an app at https://console.cloud.google.com
# Authorised redirect URI: http://<your-host>:8081/api/auth/google/callback
DING_GOOGLE_CLIENT_ID=
DING_GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth (optional) ────────────────────────────────────
# Create an app at https://github.com/settings/developers
# Authorised callback URL: http://<your-host>:8081/api/auth/github/callback
DING_GITHUB_CLIENT_ID=
DING_GITHUB_CLIENT_SECRET=
